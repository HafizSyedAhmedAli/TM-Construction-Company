+                  {busy === d.id ? "Working…" : "Approve"}
+                </Button>
+                <Button
+                  variant="outline"
+                  onClick={() => reject(d)}
+                  disabled={busy !== null}
+                  className="h-10 cursor-pointer rounded-xl px-5"
+                >
+                  Reject
+                </Button>
+              </div>
+            </section>
+          ))}
+        </div>
+      </section>
     </div>
   );
 }
